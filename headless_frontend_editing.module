<?php

/**
 * @file
 * Hook implementations; the logic lives in the classes in src/Hook.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Display\EntityFormDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\headless_frontend_editing\Hook\EntityFormHooks;
use Drupal\headless_frontend_editing\Hook\HelpHooks;
use Drupal\headless_frontend_editing\Hook\RevalidateHooks;
use Drupal\headless_frontend_editing\Hook\ThemeHooks;

/**
 * Implements hook_help().
 */
function headless_frontend_editing_help(string $route_name, RouteMatchInterface $route_match): ?string {
  return \Drupal::service(HelpHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
function headless_frontend_editing_theme(): array {
  return \Drupal::service(ThemeHooks::class)->theme();
}

/**
 * Implements hook_preprocess_HOOK() for html.
 */
function headless_frontend_editing_preprocess_html(array &$variables): void {
  \Drupal::service(ThemeHooks::class)->preprocessHtml($variables);
}

/**
 * Implements hook_entity_type_build().
 */
function headless_frontend_editing_entity_type_build(array &$entity_types): void {
  \Drupal::service(EntityFormHooks::class)->entityTypeBuild($entity_types);
}

/**
 * Implements hook_entity_form_mode_alter().
 */
function headless_frontend_editing_entity_form_mode_alter(string &$form_mode, EntityInterface $entity): void {
  \Drupal::service(EntityFormHooks::class)->formModeAlter($form_mode, $entity);
}

/**
 * Implements hook_entity_form_display_alter().
 */
function headless_frontend_editing_entity_form_display_alter(EntityFormDisplayInterface $form_display, array $context): void {
  \Drupal::service(EntityFormHooks::class)->formDisplayAlter($form_display, $context);
}

/**
 * Implements hook_form_alter().
 */
function headless_frontend_editing_form_alter(array &$form, FormStateInterface $form_state): void {
  \Drupal::service(EntityFormHooks::class)->formAlter($form, $form_state);
}

/**
 * Implements hook_entity_insert().
 */
function headless_frontend_editing_entity_insert(EntityInterface $entity): void {
  \Drupal::service(RevalidateHooks::class)->revalidate($entity);
}

/**
 * Implements hook_entity_update().
 */
function headless_frontend_editing_entity_update(EntityInterface $entity): void {
  \Drupal::service(RevalidateHooks::class)->revalidate($entity);
}

/**
 * Implements hook_entity_delete().
 */
function headless_frontend_editing_entity_delete(EntityInterface $entity): void {
  \Drupal::service(RevalidateHooks::class)->revalidate($entity);
}
